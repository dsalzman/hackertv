{
  // Cloudflare Worker "hackertv": static site from ./public + a tiny presence API.
  // Workers Builds runs `npx wrangler deploy` with this file on every push to main.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hackertv",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Only the API runs Worker code; everything else is served as plain static files
    // (free, and unaffected by Worker request limits).
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "PRESENCE", "class_name": "Presence" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Presence"] }],
  "observability": { "enabled": true }
}
